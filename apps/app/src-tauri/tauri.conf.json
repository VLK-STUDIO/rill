{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "stream-thing",
  "version": "0.1.0",
  "identifier": "com.rill.org",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun nuxt dev",
    "beforeBuildCommand": "bun run generate"
  },
  "app": {
    "windows": [
      {
        "title": "stream-thing",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "script-src": ["'self'"],
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": ["'self'", "asset:", "data:", "blob:", "https:", "http:"],
        "style-src": [
          "'self'",
          "'unsafe-inline'",
          "https://fonts.googleapis.com"
        ],
        "font-src": ["'self'", "asset:", "data:", "https://fonts.gstatic.com"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
